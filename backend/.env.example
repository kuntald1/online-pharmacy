# --- Database ---
DATABASE_URL=postgresql://pillpoints_user:pillpoints_pass@localhost:5432/pillpoints

# --- Auth ---
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# --- Razorpay ---
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_API_URL=https://graph.facebook.com/v20.0/<PHONE_NUMBER_ID>/messages
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_token
ADMIN_WHATSAPP_NUMBER=91XXXXXXXXXX

# --- Twilio (customer SMS OTP login) ---
# Get these from console.twilio.com — never commit real values, this file
# only holds placeholders. On a trial account, Twilio can only text phone
# numbers you've manually verified in the console.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# --- App ---
ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

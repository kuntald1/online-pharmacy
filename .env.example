# --- Database ---
# Using the existing external Postgres server, not a local Docker container.
# Remember: if your password contains an @ symbol, URL-encode it as %40
# (e.g. PillPoints@123 -> PillPoints%40123) or the URL will be misread.
DATABASE_URL=postgresql://pillpoints_user:REPLACE_WITH_YOUR_PASSWORD@187.127.150.252:5432/pillpoints_db

# --- Backend ---
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
ADMIN_WHATSAPP_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Needed for the "Restock from invoice" feature (Products page) — reads an
# uploaded invoice photo/PDF and extracts line items. Get a key at
# https://console.anthropic.com. Leave blank to disable that one feature;
# everything else works without it.
ANTHROPIC_API_KEY=
CORS_ORIGINS=http://localhost:8090,http://localhost:8095
ENV=production

# --- Admin frontend (baked in at build time) ---
VITE_API_URL=http://localhost:8020
